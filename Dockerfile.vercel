FROM python:3.12-slim

# GeoDjango requires these native libraries. The standard Vercel Python
# runtime does not bundle them, so FiCol runs in Vercel's Container runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gdal-bin \
        libgdal-dev \
        libgeos-dev \
        libpq-dev \
        binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VERCEL=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./
RUN chmod +x /app/docker-start.sh

EXPOSE 80
CMD ["sh", "/app/docker-start.sh"]
