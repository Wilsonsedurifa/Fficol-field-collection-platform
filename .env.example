# Copy these email settings to your own .env file.
# Replace the Gmail address (twice) and Google App Password.
# Never commit real credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-ficol-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL="FiCol <your-ficol-email@gmail.com>"
EMAIL_TIMEOUT=15
# Public application origin used for invitation emails sent without a request.
SITE_URL=http://localhost:8000

# Vercel production configuration (set these in Vercel; do not commit secrets)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DJANGO_ALLOWED_HOSTS=.vercel.app,your-custom-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com
# PRIVATE_STORAGE_BUCKET=your-private-bucket
# PRIVATE_STORAGE_ACCESS_KEY=your-access-key
# PRIVATE_STORAGE_SECRET_KEY=your-secret-key
# PRIVATE_STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# PRIVATE_STORAGE_REGION=auto
